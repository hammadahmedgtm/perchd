# Supabase — from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paddle — from Paddle Dashboard > Developer Tools > Authentication
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# A Paddle "Product" that inline/non-catalog transaction prices attach to —
# create one (e.g. "Perchd sticker spot") in Paddle > Catalog > Products.
PADDLE_PRODUCT_ID=
